# Ambiente: development | test | production
NODE_ENV=development
# Porta HTTP da API
PORT=3000
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# PostgreSQL (docker compose sobe um em localhost:5432)
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5432/helpdesk?schema=public
# Nível de log do Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Segredo do JWT (mín. 32 caracteres). Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais
# Validade do access token (segundos) e do refresh token (dias)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Tentativas de login por minuto, por IP
LOGIN_RATE_LIMIT=5
# Redis (filas BullMQ). docker compose sobe um em localhost:6379
REDIS_URL=redis://localhost:6379
# Intervalo do job que marca chamados com SLA estourado (ms, mín. 1000)
SLA_CHECK_INTERVAL_MS=60000
# --- Triagem por IA ---
# Chave da API da Anthropic. VAZIA = modo fake (regras locais, sem custo). Nunca commite a chave.
ANTHROPIC_API_KEY=
# Modelo usado na triagem (classificação simples: Haiku é o mais barato e rápido)
LLM_MODEL=claude-haiku-4-5
# Tempo máximo de espera por resposta do LLM (ms)
LLM_TIMEOUT_MS=15000
# Tentativas por job e atraso base do backoff exponencial (2s, 4s, 8s...)
TRIAGE_MAX_ATTEMPTS=4
TRIAGE_BACKOFF_MS=2000
